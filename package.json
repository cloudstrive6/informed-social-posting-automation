{
  "name": "informed-social-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "InforMed Lab: autonomous multi-agent health content studio for YouTube, Instagram, TikTok and Facebook",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "radar": "tsx src/cli.ts radar",
    "plan": "tsx src/cli.ts plan",
    "produce": "tsx src/cli.ts produce",
    "finalize": "tsx src/cli.ts finalize",
    "publish": "tsx src/cli.ts publish",
    "analytics": "tsx src/cli.ts analytics",
    "doctor": "tsx src/cli.ts doctor",
    "auth:youtube": "tsx scripts/auth-youtube.ts",
    "auth:tiktok": "tsx scripts/auth-tiktok.ts",
    "auth:meta": "tsx scripts/auth-meta.ts",
    "typecheck": "tsc --noEmit",
    "sfx:kit": "tsx scripts/audio-assets.ts sfx",
    "music:library": "tsx scripts/audio-assets.ts music 4 300"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@iconify-json/healthicons": "^1.2.13",
    "fast-xml-parser": "^5.11.1",
    "gsap": "^3.14.2",
    "hyperframes": "^0.8.77",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
