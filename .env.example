# Local runs only. In production these are GitHub Actions secrets (Settings → Secrets and variables → Actions).
# Never commit a real .env — this repo is public.

# Agents' brains — from `claude setup-token` (valid 1 year)
CLAUDE_CODE_OAUTH_TOKEN=

# ElevenLabs: narration, music, sound effects (paid)
ELEVENLABS_API_KEY=

# Stock footage/photos (free keys; at least one)
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Optional: higher limits for free AI thumbnail images
POLLINATIONS_TOKEN=

# YouTube uploads (npm run auth:youtube)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# YouTube trend research — API key from a SEPARATE Google Cloud project (own quota)
YOUTUBE_API_KEY=

# Instagram + Facebook (npm run auth:meta)
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
# META_GRAPH_VERSION=v23.0

# TikTok (npm run auth:tiktok)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
# TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE

# Optional trend sources
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
NCBI_API_KEY=

# Local Python with Kokoro (Python 3.10–3.12)
# PYTHON=python/.venv/Scripts/python.exe
